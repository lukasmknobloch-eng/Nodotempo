{%- liquid
  assign coll = section.settings.collection
  if coll == blank
    assign coll = collections.all
  endif
-%}
<section class="section-grid">
  {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="grid-products">
    {% render 'variant-grid-items', products: coll.products, limit: section.settings.limit %}
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="center-row">
      <a href="{{ coll.url }}" class="btn btn-outline">{{ section.settings.button_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Produktraster",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift" },
    { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Leer = alle Produkte" },
    { "type": "range", "id": "limit", "label": "Anzahl Farben", "min": 4, "max": 40, "step": 4, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Alle ansehen" }
  ],
  "presets": [{ "name": "Produktraster" }]
}
{% endschema %}
