{%- comment -%}
  Zwei Modelle gleichwertig nebeneinander (auch auf dem Handy).
  Ohne eigenes Bild wird das zweite Produktfoto (schräge Ansicht) verwendet.
{%- endcomment -%}
<section class="models">
  {%- for i in (1..2) -%}
    {%- liquid
      if i == 1
        assign p = section.settings.product_1 | default: all_products['nodo-no-2']
        assign img = section.settings.image_1
      else
        assign p = section.settings.product_2 | default: all_products['nodo-no-1']
        assign img = section.settings.image_2
      endif
      if p == blank or p.title == blank
        continue
      endif
      if img == blank
        assign img = p.images[1] | default: p.featured_image
      endif
    -%}
    <a href="{{ p.url }}" class="model-tile">
      <div class="model-media">
        {%- if img != blank -%}
          {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(max-width: 700px) 50vw, 50vw', alt: p.title }}
        {%- endif -%}
      </div>
      <div class="model-copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ p.title }}</h2>
        <p class="muted">{{ p.variants.size }} Farben · {{ p.price_min | money }}</p>
        <span class="text-link">{{ p.title }} ansehen</span>
      </div>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Zwei Modelle",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "The Nato-Series" },
    { "type": "product", "id": "product_1", "label": "Modell links", "info": "Leer = Nodo No. 2" },
    { "type": "image_picker", "id": "image_1", "label": "Bild links" },
    { "type": "product", "id": "product_2", "label": "Modell rechts", "info": "Leer = Nodo No. 1" },
    { "type": "image_picker", "id": "image_2", "label": "Bild rechts" }
  ],
  "presets": [{ "name": "Zwei Modelle" }]
}
{% endschema %}
