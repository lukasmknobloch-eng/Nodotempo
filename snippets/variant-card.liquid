{%- comment -%}
  Eine Kachel: ein Armband in einer Farbe.
  Parameter: product (Pflicht), variant (optional), preload (optional)
  Bilder je Farbe werden über den Alt-Text zugeordnet: „Farbname | Farbbeschreibung“.
{%- endcomment -%}
{%- liquid
  if variant == blank
    assign variant = product.selected_or_first_available_variant
  endif
  assign main = variant.featured_media | default: product.featured_media
  assign hover = nil
  unless product.has_only_default_variant
    for m in product.media
      assign alt_name = m.alt | split: ' |' | first | strip
      if alt_name == variant.title and m.id != main.id
        assign hover = m
        break
      endif
    endfor
  endunless
  if product.has_only_default_variant
    assign subtitle = product.type
    assign url = product.url
  else
    assign subtitle = variant.title
    assign url = variant.url
  endif
  assign alt = product.title | append: ' ' | append: variant.title | strip | escape
  if preload
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif
-%}
<a href="{{ url }}" class="card">
  <div class="card-media">
    <div class="product-image">
      {%- if main -%}
        {{ main | image_url: width: 900 | image_tag: loading: loading, widths: '360, 540, 720, 900', sizes: '(max-width: 1000px) 50vw, 25vw', alt: alt }}
      {%- else -%}
        <span class="product-image-empty">Foto folgt</span>
      {%- endif -%}
    </div>
    {%- if hover -%}
      <div class="product-image card-media-alt">
        {{ hover | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 1000px) 50vw, 25vw', alt: alt }}
      </div>
    {%- endif -%}
    {%- unless variant.available -%}<span class="tag">Ausverkauft</span>{%- endunless -%}
  </div>
  <div class="card-body">
    <div>
      <h3 class="card-title">{{ product.title }}</h3>
      {%- if subtitle != blank -%}<p class="card-sub">{{ subtitle }}</p>{%- endif -%}
    </div>
    <p class="card-price">
      {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
      {{ variant.price | money }}
    </p>
  </div>
</a>
