# Öffentliche Adresse des Shops (ohne abschließenden Schrägstrich)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe – https://dashboard.stripe.com/apikeys
# Zum Testen die "sk_test_..." Schlüssel verwenden, für den Live-Betrieb "sk_live_...".
STRIPE_SECRET_KEY=sk_test_xxx
# Signatur-Geheimnis des Webhooks (Dashboard → Entwickler → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Zahlungsarten im Checkout. "card" enthält automatisch Apple Pay & Google Pay.
# Mit "auto" werden die im Stripe-Dashboard aktivierten Zahlungsarten verwendet.
STRIPE_PAYMENT_METHODS=card,paypal,klarna

# Optional: E-Mail-Versand für das Kontaktformular über Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=hallo@nodotempo.de
CONTACT_FROM_EMAIL=Nodotempo <shop@nodotempo.de>
