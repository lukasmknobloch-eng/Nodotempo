{%- comment -%}
  Rendert für jede Farbe jedes Produkts eine Kachel.
  Parameter: products (Liste), limit (optional, Anzahl Kacheln), preload_count (optional)
{%- endcomment -%}
{%- liquid
  assign shown = 0
  assign max = limit | default: 999
  assign preload_count = preload_count | default: 4
  for product in products
    if shown >= max
      break
    endif
    if product.has_only_default_variant
      assign preload = false
      if shown < preload_count
        assign preload = true
      endif
      render 'variant-card', product: product, preload: preload
      assign shown = shown | plus: 1
    else
      for variant in product.variants
        if shown >= max
          break
        endif
        assign preload = false
        if shown < preload_count
          assign preload = true
        endif
        render 'variant-card', product: product, variant: variant, preload: preload
        assign shown = shown | plus: 1
      endfor
    endif
  endfor
-%}
