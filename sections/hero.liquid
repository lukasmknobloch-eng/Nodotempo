{%- liquid
  assign has_photo = false
  if section.settings.image != blank or section.settings.use_default_image
    assign has_photo = true
  endif
  assign bw_class = ''
  if section.settings.black_white
    assign bw_class = 'is-bw'
  endif
-%}
<section class="hero {% if has_photo %}hero-photo{% else %}hero-split{% endif %} focus-{{ section.settings.focus }}">
  {%- if has_photo -%}
    <div class="hero-media">
      {%- if section.settings.image == blank -%}
        <img src="{{ 'hero.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1500" height="998" fetchpriority="high">
      {%- else -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.heading, class: bw_class }}
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="hero-media hero-media-split">
      <div>{% render 'fallback-image', index: 0, angled: true, sizes: '50vw', eager: true %}</div>
      <div>{% render 'fallback-image', index: 1, angled: true, sizes: '50vw', eager: true %}</div>
    </div>
  {%- endif -%}
  <div class="hero-copy">
    {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn {% if has_photo %}btn-outline-light{% else %}btn-outline{% endif %}">
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Großes Bild",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild", "info": "Querformat, mind. 2400 px breit. Ohne Bild werden zwei Produktfotos gezeigt." },
    { "type": "checkbox", "id": "use_default_image", "label": "Standard-Titelbild verwenden (Golf-Foto), wenn kein Bild gewählt ist", "default": true },
    { "type": "checkbox", "id": "black_white", "label": "Schwarz-Weiß", "default": true, "info": "Gilt nur für ein selbst hochgeladenes Bild. Beim Standard-Titelbild sind bereits nur die Bänder farbig." },
    { "type": "select", "id": "focus", "label": "Bildausschnitt", "default": "center", "options": [{ "value": "top", "label": "Oben" }, { "value": "center", "label": "Mitte" }, { "value": "bottom", "label": "Unten" }] },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Getragen neben der Zeit" },
    { "type": "text", "id": "text", "label": "Text", "default": "The Nato-Series · Handgeknüpft aus Fallschirmseil" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Armbänder ansehen" },
    { "type": "url", "id": "button_link", "label": "Button-Link" }
  ],
  "presets": [{ "name": "Großes Bild" }]
}
{% endschema %}
