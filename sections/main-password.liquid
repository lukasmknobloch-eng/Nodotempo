<section class="password">
  <div class="password-media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '800, 1200, 1600, 2400', sizes: '100vw', class: 'is-bw' }}
    {%- else -%}
      <img src="{{ 'hero.jpg' | asset_url }}" alt="" width="1500" height="998" class="is-bw">
    {%- endif -%}
  </div>
  <div class="password-card">
    {%- if section.settings.show_mark -%}{% render 'logo-mark', class: 'password-mark' %}{%- endif -%}
    {% render 'logo', class: 'password-logo' %}
    <p class="password-text">{{ section.settings.text }}</p>
    {%- form 'storefront_password', class: 'password-form' -%}
      {%- if form.errors -%}<p class="form-error">Das Passwort stimmt nicht.</p>{%- endif -%}
      <label class="sr-only" for="password">Passwort</label>
      <input id="password" type="password" name="password" placeholder="Passwort" autocomplete="current-password" required>
      <button class="btn btn-primary" type="submit">Eintreten</button>
    {%- endform -%}
    <div class="password-newsletter">
      <p class="muted small">Noch kein Passwort? Trag dich ein, wir sagen dir Bescheid, sobald es losgeht.</p>
      {% render 'newsletter-form', id: 'password' %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Passwortseite",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hintergrundbild", "info": "Wird schwarz-weiß gezeigt. Ohne Auswahl: das Golf-Foto" },
    { "type": "checkbox", "id": "show_mark", "label": "Logo-Zeichen zeigen", "default": true },
    { "type": "text", "id": "text", "label": "Text", "default": "Bald geht es los. Mit Passwort kannst du schon jetzt alle Farben ansehen." }
  ]
}
{% endschema %}
