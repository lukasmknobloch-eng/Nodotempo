<section class="banner {% if section.settings.image != blank %}banner-photo{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="banner-media">
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2400', sizes: '100vw' }}
    </div>
  {%- endif -%}
  <div class="banner-copy">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '/products/nodo-no-1' }}" class="btn btn-outline-light">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild", "info": "Ohne Bild: dunkelgrüne Fläche" },
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "The Nato-Series" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Nodo No. 1" },
    { "type": "text", "id": "text", "label": "Text", "default": "Feineres Fallschirmseil, derselbe Knoten." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Nodo No. 1 ansehen" },
    { "type": "url", "id": "button_link", "label": "Button-Link" }
  ],
  "presets": [{ "name": "Banner" }]
}
{% endschema %}
