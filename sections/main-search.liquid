<section class="page-shop">
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page-form">
    <input type="hidden" name="type" value="product">
    <label class="sr-only" for="search-input">Suche</label>
    <input id="search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Suche nach Farbe oder Modell" autofocus>
    <button class="btn btn-primary" type="submit">Suchen</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="muted search-count">{{ search.results_count }} Ergebnis{% if search.results_count != 1 %}se{% endif %} für „{{ search.terms | escape }}“</p>
      {%- if search.results_count > 0 -%}
        <div class="grid-products">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- liquid
                assign term = search.terms | downcase
                assign matched = false
                for v in item.variants
                  assign vname = v.title | downcase
                  assign vcolor = v.featured_media.alt | downcase
                  if vname contains term or vcolor contains term
                    render 'variant-card', product: item, variant: v
                    assign matched = true
                  endif
                endfor
                unless matched
                  for v in item.variants
                    render 'variant-card', product: item, variant: v
                  endfor
                endunless
              -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>
{% schema %}
{ "name": "Suche", "settings": [] }
{% endschema %}
