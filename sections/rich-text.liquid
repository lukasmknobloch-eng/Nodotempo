<section class="page container narrow prose {% if section.settings.centered %}is-centered{% endif %}">
  {%- if section.settings.heading != blank -%}
    {%- if section.settings.is_title -%}<h1 class="h1 page-head">{{ section.settings.heading }}</h1>{%- else -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  {%- endif -%}
  <div class="rte">{{ section.settings.text }}</div>
</section>
{% schema %}
{
  "name": "Text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift" },
    { "type": "checkbox", "id": "is_title", "label": "Als Seitentitel", "default": false },
    { "type": "checkbox", "id": "centered", "label": "Zentriert", "default": false },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
