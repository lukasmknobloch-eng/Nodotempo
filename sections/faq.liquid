<section class="page container narrow">
  {%- if section.settings.heading != blank -%}<h1 class="h1 page-head">{{ section.settings.heading }}</h1>{%- endif -%}
  <div class="accordion faq">
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }} {% render 'icon', name: 'chevron' %}</summary>
        <div class="rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Häufige Fragen",
  "settings": [{ "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" }],
  "blocks": [
    {
      "type": "question",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Frage" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Antwort</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Häufige Fragen" }]
}
{% endschema %}
